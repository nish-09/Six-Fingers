# Six Fingers — Frontend Environment Configuration
# Copy this file to .env.local and adjust for production or local development

# Backend API Base URL (HTTP/HTTPS)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend WebSocket Base URL (WS/WSS)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Production Canonical Site URL (Used for Canonical URLs, Open Graph, Sitemap & Robots)
NEXT_PUBLIC_SITE_URL=https://sixfingers.game

# Google Search Console Verification Token (HTML tag verification method)
# Obtain this token from Google Search Console > Settings > Ownership Verification > HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
