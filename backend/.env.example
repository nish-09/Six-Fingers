# Six Fingers — Backend Environment Configuration
# Copy this file to .env and modify values for production deployment

# Application Environment
ENVIRONMENT=production
PORT=8000

# Security & Authentication
# IMPORTANT: Generate a cryptographically secure random string in production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
#
# IMPORTANT FOR RENDER DEPLOYMENTS:
# Render standard/free web services do NOT support outbound IPv6.
# Supabase direct connection (db.[PROJECT-REF].supabase.co) resolves to IPv6 only on free tier.
# Therefore, on Render, ALWAYS use the Connection Pooler URL (IPv4 compatible):
#
# 1. Connection Pooler - Transaction Mode (Port 6543 - RECOMMENDED FOR RENDER):
#    DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# 2. Connection Pooler - Session Mode (Port 5432 - IPv4 compatible):
#    DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# 3. Direct Connection (Port 5432 - requires IPv6 network support):
#    DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Local Development default (SQLite fallback):
# DATABASE_URL=sqlite+aiosqlite:///./hand_cricket.db
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Database Pool Settings (Optional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30
DB_SSL=true

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://sixfingers.gg,https://yourdomain.com
