# Six Fingers — Backend Environment Configuration
# Copy this file to .env and modify values for production deployment

# Application Environment
ENVIRONMENT=production
PORT=8000

# Security & Authentication
# IMPORTANT: Generate a cryptographically secure random string in production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# SQLite default: sqlite:///./hand_cricket.db
# PostgreSQL for high concurrency: postgresql+psycopg2://user:password@localhost:5432/six_fingers
DATABASE_URL=sqlite:///./hand_cricket.db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://sixfingers.gg,https://yourdomain.com
