# Six Fingers - Hand Cricket Environment Configuration

# Backend
PORT=8000
ENVIRONMENT=development
# Production (Supabase PostgreSQL): postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Local Development (SQLite): sqlite+aiosqlite:///./hand_cricket.db
DATABASE_URL=sqlite+aiosqlite:///./hand_cricket.db
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_SITE_URL=https://sixfingers.game
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
